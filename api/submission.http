############################################################
# MEMORY LIMIT EXCEEDED - MLE
############################################################

### C++ MLE
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "cpp",
  "studentCode": "class Solution { public: int search(vector<int>& nums, int target) { vector<int> data; while (true) { data.resize(data.size() + 1000000); } return -1; } };"
}

### Java MLE
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "java",
  "studentCode": "class Solution { public int search(int[] nums, int target) { java.util.ArrayList<byte[]> data = new java.util.ArrayList<>(); while (true) { data.add(new byte[10000000]); } } }"
}

### JavaScript MLE
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "js",
  "studentCode": "var search = function(nums, target) { const data = []; while (true) { data.push(new Array(1000000).fill(0)); } };"
}

### Python MLE
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "py",
  "studentCode": "class Solution:\n    def search(self, nums, target):\n        data = []\n        while True:\n            data.append(bytearray(10000000))"
}


