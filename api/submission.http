@baseUrl = {{$dotenv BASEURL}}
@StudentAccessToken = {{$dotenv STUDENT_TOKEN}}
@problemId = 6ac796734e3de34b9a9ee62c

############################################################
# GET ALL SUBMISSIONS
############################################################

### Get All Submissions
GET {{baseUrl}}/api/submit/all
Cookie: accessToken={{StudentAccessToken}}

# GetStudentProblemSubmissions

GET {{baseUrl}}/api/submit/getStudentProblemSubmissions/6ac796734e3de34b9a9ee62c
Cookie: accessToken={{StudentAccessToken}}

### DELETE All Submissions
DELETE {{baseUrl}}/api/submit/all
Cookie: accessToken={{StudentAccessToken}}

############################################################
# ACCEPTED - AC
############################################################

### C++ Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
    "problemId": "{{problemId}}",
    "language": "cpp",
    "studentCode": "class  Solution { public: vector<int> calculateTotalAndAverage(int a, int b, int c) { int total = a + b + c; int average = total / 3; return {total, average}; } };"
}


### Java Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
    "problemId": "{{problemId}}",
    "language": "java",
    "studentCode": "class  Solution { public int[] calculateTotalAndAverage(int a, int b, int c) { int total = a + b + c; int average = total / 3; return new int[]{total, average}; } }"
}


### JavaScript Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
    "problemId": "{{problemId}}",
    "language": "js",
    "studentCode": "var  calculateTotalAndAverage = function(a, b, c) { const total = a + b + c; const average = Math.floor(total / 3); return [total, average]; };"
}


### Python Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
    "problemId": "{{problemId}}",
    "language": "py",
    "studentCode": "class  Solution:\n    def calculateTotalAndAverage(self, a, b, c):\n        total = a + b + c\n        average = total // 3\n        return [total, average]"
}


