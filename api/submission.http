{
    "problemId": "{{problemId}}",
    "language": "java",
    "studentCode": "class Solution { public int[] calculateTotalAndAverage(int a, int b, int c) { int[] data = new int[1]; int x = data[999999]; return new int[]{x, 0}; } }"
