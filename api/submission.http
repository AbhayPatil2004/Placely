@baseUrl = {{$dotenv BASEURL}}
@StudentAccessToken = {{$dotenv STUDENT_TOKEN}}
@problemId = 6ac3af14defbc7efea34c6ae

############################################################
# GET ALL SUBMISSIONS
############################################################

### Get All Submissions
GET {{baseUrl}}/api/submit/all
Cookie: accessToken={{StudentAccessToken}}

# getStudentProblemSubmissions
GET {{baseUrl}}/api/submit/getStudentProblemSubmissions/6ac3af14defbc7efea34c6ae
Cookie: accessToken={{StudentAccessToken}}

### DELETE All Submissions
DELETE {{baseUrl}}/api/submit/all
Cookie: accessToken={{StudentAccessToken}}

############################################################
# ACCEPTED - CORRECT SOLUTIONS
############################################################

### C++ Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "cpp",
  "studentCode": "class  Solution { public: int search(vector<int>& nums, int target) { cout << \"Target: \" << target << endl; int left = 0, right = nums.size() - 1; while (left <= right) { int mid = left + (right - left) / 2; cout << \"Mid: \" << mid << endl; if (nums[mid] == target) return mid; if (nums[mid] < target) left = mid + 1; else right = mid - 1; } return -1; } };"
}

### Java Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "java",
  "studentCode": "class  Solution  { public int search(int[] nums, int target) { System.out.println(\"Searching for target: \" + target); int left = 0, right = nums.length - 1; while (left <= right) { int mid = left + (right - left) / 2; System.out.println(\"Checking index: \" + mid); if (nums[mid] == target) { System.out.println(\"Target found at index: \" + mid); return mid; } if (nums[mid] < target) left = mid + 1; else right = mid - 1; } System.out.println(\"Target not found\"); return -1; } }"
}

### JavaScript Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "js",
  "studentCode": "var   search = function(nums, target) { console.log(\"Searching for target: \" + target); let left = 0, right = nums.length - 1; while (left <= right) { const mid = Math.floor(left + (right - left) / 2); console.log(\"Checking index: \" + mid); if (nums[mid] === target) { console.log(\"Target found at index: \" + mid); return mid; } if (nums[mid] < target) left = mid + 1; else right = mid - 1; } console.log(\"Target not found\"); return -1; };"
}


### Python Accepted
POST {{baseUrl}}/api/submit/code
Content-Type: application/json
Cookie: accessToken={{StudentAccessToken}}

{
  "problemId": "{{problemId}}",
  "language": "py",
  "studentCode": "class    Solution:\n     def search(self, nums, target):\n        print(\"Searching for target:\", target)\n        left = 0\n        right = len(nums) - 1\n        while left <= right:\n            mid = left + (right - left) // 2\n            print(\"Checking index:\", mid)\n            if nums[mid] == target:\n                print(\"Target found at index:\", mid)\n                return mid\n            if nums[mid] < target:\n                left = mid + 1\n            else:\n                right = mid - 1\n        print(\"Target not found\")\n        return -1"
}


