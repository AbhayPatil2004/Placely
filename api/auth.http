############################################################
#                    STUDENT AUTH APIs
############################################################

### 1. Student Signup
POST http://localhost:5000/api/auth/student/signup
Content-Type: application/json

{
    "fullname": "Abhay Patil",
    "studentId": "STU001",
    "email": "abhay.student@gmail.com",
    "branch": "Computer Science and Engineering",
    "college": "KBTCOE",
    "collegeId": "KBT001",
    "currentYear": 4,
    "passingYear": 2027,
    "password": "Abhay@123"
}


### 2. Student Login
POST http://localhost:5000/api/auth/student/login
Content-Type: application/json

{
    "email": "abhay.student@gmail.com",
    "password": "Abhay@123"
}


### 3. Student Logout
POST http://localhost:5000/api/auth/student/logout


### 4. Student Forgot Password
POST http://localhost:5000/api/auth/student/forgot-password
Content-Type: application/json

{
    "email": "abhay.student@gmail.com"
}


### 5. Student Verify OTP
POST http://localhost:5000/api/auth/student/verify-otp
Content-Type: application/json

{
    "email": "abhay.student@gmail.com",
    "otp": "330379",
    "newPassword": "NewAbhay@123"
}



