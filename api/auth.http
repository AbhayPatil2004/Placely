@baseUrl = {{$dotenv BASEURL}}

############################################################

# STUDENT AUTH APIs

############################################################

### 1. Student Signup

POST {{baseUrl}}/api/auth/student/signup
Content-Type: application/json

{
"fullname": "Abhay Patil",
"studentId": "STU001",
"email": "[patilabhay484@gmail.com](mailto:patilabhay484@gmail.com)",
"branch": "Computer Science and Engineering",
"college": "KBTCOE",
"collegeId": "KBT001",
"currentYear": 4,
"passingYear": 2027,
"password": "Abhay@123"
}

### 2. Student Login

POST {{baseUrl}}/api/auth/student/login
Content-Type: application/json

{
"email": "[patilabhay484@gmail.com](mailto:patilabhay484@gmail.com)",
"password": "Abhay@123"
}

### 3. Student Logout

POST {{baseUrl}}/api/auth/student/logout

### 4. Student Forgot Password

POST {{baseUrl}}/api/auth/student/forgot-password
Content-Type: application/json

{
"email": "[patilabhay484@gmail.com](mailto:patilabhay484@gmail.com)"
}

### 5. Student Verify OTP

POST {{baseUrl}}/api/auth/student/verify-otp
Content-Type: application/json

{
"email": "[patilabhay484@gmail.com](mailto:patilabhay484@gmail.com)",
"otp": "686612",
"newPassword": "NewAbhay@123"
}

