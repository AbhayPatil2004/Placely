
@baseUrl = {{$dotenv BASEURL}}
@AdminAccessToken = {{$dotenv ADMIN_TOKEN}}
@StudentAccessToken = {{$dotenv STUDENT_TOKEN}}

############################################################
# . ADD Multiple PROBLEM
############################################################

POST {{baseUrl}}/api/problem/multiple
Content-Type: application/json
Cookie: accessToken={{AdminAccessToken}}

###########################################################
# . GET All PROBLEM
############################################################

GET {{baseUrl}}/api/problem/all


###########################################################
# . GET PROBLEM
############################################################

GET {{baseUrl}}/api/problem/calculate-total-and-average-of-three-numbers

############################################################
# . GET Problem Sheet
############################################################

GET {{baseUrl}}/api/problem/sheet
Cookie: accessToken={{StudentAccessToken}}

############################################################
# . ADD PROBLEM
############################################################

POST {{baseUrl}}/api/problem
Content-Type: application/json
Cookie: accessToken={{AdminAccessToken}}

{
  "title": "Binary Search",
  "slug": "binary-search",
  "problemStatement": "Given a sorted array of integers nums and an integer target, return the index of target if it exists in the array. Otherwise, return -1.",
  
  "topic": "ARRAY",
  "subTopics": ["BINARY_SEARCH"],
  "tags": ["array", "binary-search", "searching"],
  "pattern": ["BINARY_SEARCH"],
  "difficulty": "EASY",

  "inputFormat": "The driver defines the sorted array and target for each test case.",

  "outputFormat": "Return the index of target if it exists in the array. Otherwise, return -1.",

  "constraints": [
    "1 <= nums.length <= 10^4",
    "-10^4 <= nums[i] <= 10^4",
    "nums is sorted in ascending order",
    "-10^4 <= target <= 10^4"
  ],

  "examples": [
    {
      "input": "nums = [-1,0,3,5,9,12], target = 9",
      "output": "4"
    },
    {
      "input": "nums = [-1,0,3,5,9,12], target = 2",
      "output": "-1"
    }
  ],

  "starterCode": {
    "cpp": "class Solution {\npublic:\n    int search(vector<int>& nums, int target) {\n        // Write your code here\n        return -1;\n    }\n};",

    "java": "class Solution {\n    public int search(int[] nums, int target) {\n        // Write your code here\n        return -1;\n    }\n}",

    "javascript": "var search = function(nums, target) {\n    // Write your code here\n    return -1;\n};",

    "python": "class Solution:\n    def search(self, nums, target):\n        # Write your code here\n        return -1"
  },

  "driverCode": {
    "cpp": "int main() {\n    Solution solution;\n    int total = 5, passed = 0;\n    vector<string> testCasesResult;\n\n    auto check = [&](int tc, vector<int> nums, int target, int expected) {\n        string logs;\n        stringstream buffer;\n        streambuf* oldCout = cout.rdbuf(buffer.rdbuf());\n\n        int actual = -1;\n        bool runtimeError = false;\n\n        try {\n            actual = solution.search(nums, target);\n        } catch (...) {\n            runtimeError = true;\n        }\n\n        cout.rdbuf(oldCout);\n        logs = buffer.str();\n\n        string status = (!runtimeError && actual == expected) ? \"passed\" : \"wrong_answer\";\n        if (status == \"passed\") passed++;\n\n        testCasesResult.push_back(\n            \"{\\\"testCase\\\":\\\"nums = [\" + [&]() { string s; for (int i = 0; i < nums.size(); i++) { if (i) s += \",\"; s += to_string(nums[i]); } return s; }() + \"], target = \" + to_string(target) + \"\\\",\\\"expectedOutput\\\":\\\"\" + to_string(expected) + \"\\\",\\\"actualOutput\\\":\\\"\" + to_string(actual) + \"\\\",\\\"logs\\\":\\\"\" + logs + \"\\\",\\\"status\\\":\\\"\" + status + \"\\\"}\"\n        );\n    };\n\n    check(1, {-1,0,3,5,9,12}, 9, 4);\n    check(2, {-1,0,3,5,9,12}, 2, -1);\n    check(3, {1,3,5,7,9}, 1, 0);\n    check(4, {1,3,5,7,9}, 9, 4);\n    check(5, {1,3,5,7,9}, 6, -1);\n\n    cout << \"{\\\"totalTestCases\\\":\" << total\n         << \",\\\"passedTestCases\\\":\" << passed\n         << \",\\\"testCasesResult\\\":[\";\n\n    for (int i = 0; i < testCasesResult.size(); i++) {\n        if (i) cout << \",\";\n        cout << testCasesResult[i];\n    }\n\n    cout << \"]}\" << endl;\n    return 0;\n}",

    "java": "public class Main {\n    public static void main(String[] args) {\n        Solution solution = new Solution();\n        int[][] numsCases = {\n            {-1,0,3,5,9,12},\n            {-1,0,3,5,9,12},\n            {1,3,5,7,9},\n            {1,3,5,7,9},\n            {1,3,5,7,9}\n        };\n        int[] targets = {9,2,1,9,6};\n        int[] expected = {4,-1,0,4,-1};\n        int passed = 0;\n        List<String> testCasesResult = new ArrayList<>();\n\n        for (int i = 0; i < numsCases.length; i++) {\n            ByteArrayOutputStream buffer = new ByteArrayOutputStream();\n            PrintStream oldOut = System.out;\n            System.setOut(new PrintStream(buffer));\n\n            int actual = -1;\n            boolean runtimeError = false;\n\n            try {\n                actual = solution.search(numsCases[i], targets[i]);\n            } catch (Throwable e) {\n                runtimeError = true;\n            }\n\n            System.setOut(oldOut);\n            String logs = buffer.toString();\n\n            String status = (!runtimeError && actual == expected[i]) ? \"passed\" : \"wrong_answer\";\n            if (status.equals(\"passed\")) passed++;\n\n            testCasesResult.add(\n                \"{\\\"testCase\\\":\\\"test case \" + (i + 1) + \"\\\",\\\"expectedOutput\\\":\\\"\" + expected[i] + \"\\\",\\\"actualOutput\\\":\\\"\" + actual + \"\\\",\\\"logs\\\":\\\"\" + logs.replace(\"\\\\\", \"\\\\\\\\\").replace(\"\\\"\", \"\\\\\\\"\").replace(\"\\n\", \"\\\\n\") + \"\\\",\\\"status\\\":\\\"\" + status + \"\\\"}\"\n            );\n        }\n\n        System.out.print(\n            \"{\\\"totalTestCases\\\":\" + numsCases.length +\n            \",\\\"passedTestCases\\\":\" + passed +\n            \",\\\"testCasesResult\\\":[\" +\n            String.join(\",\", testCasesResult) + \"]}\"\n        );\n    }\n}",

    "javascript": "const numsCases = [[-1,0,3,5,9,12],[-1,0,3,5,9,12],[1,3,5,7,9],[1,3,5,7,9],[1,3,5,7,9]];\nconst targets = [9,2,1,9,6];\nconst expected = [4,-1,0,4,-1];\nlet passed = 0;\nconst testCasesResult = [];\n\nfor (let i = 0; i < numsCases.length; i++) {\n    let logs = \"\";\n    const originalLog = console.log;\n    console.log = (...args) => {\n        logs += args.map(String).join(\" \") + \"\\n\";\n    };\n\n    let actual = -1;\n    let runtimeError = false;\n\n    try {\n        actual = search(numsCases[i], targets[i]);\n    } catch (e) {\n        runtimeError = true;\n    }\n\n    console.log = originalLog;\n\n    const status = (!runtimeError && actual === expected[i]) ? \"passed\" : \"wrong_answer\";\n    if (status === \"passed\") passed++;\n\n    testCasesResult.push({\n        testCase: `nums = [${numsCases[i].join(\",\")}], target = ${targets[i]}`,\n        expectedOutput: String(expected[i]),\n        actualOutput: String(actual),\n        logs,\n        status\n    });\n}\n\nconsole.log(JSON.stringify({\n    totalTestCases: numsCases.length,\n    passedTestCases: passed,\n    testCasesResult\n}));",

    "python": "import json\nimport io\nimport sys\n\nnums_cases = [\n    [-1,0,3,5,9,12],\n    [-1,0,3,5,9,12],\n    [1,3,5,7,9],\n    [1,3,5,7,9],\n    [1,3,5,7,9]\n]\n\ntargets = [9,2,1,9,6]\nexpected = [4,-1,0,4,-1]\n\nsolution = Solution()\npassed = 0\ntest_cases_result = []\n\nfor i, nums in enumerate(nums_cases):\n    buffer = io.StringIO()\n    old_stdout = sys.stdout\n    sys.stdout = buffer\n\n    actual = -1\n    runtime_error = False\n\n    try:\n        actual = solution.search(nums, targets[i])\n    except Exception:\n        runtime_error = True\n\n    sys.stdout = old_stdout\n    logs = buffer.getvalue()\n\n    status = \"passed\" if not runtime_error and actual == expected[i] else \"wrong_answer\"\n\n    if status == \"passed\":\n        passed += 1\n\n    test_cases_result.append({\n        \"testCase\": f\"nums = [{','.join(map(str, nums))}], target = {targets[i]}\",\n        \"expectedOutput\": str(expected[i]),\n        \"actualOutput\": str(actual),\n        \"logs\": logs,\n        \"status\": status\n    })\n\nprint(json.dumps({\n    \"totalTestCases\": len(nums_cases),\n    \"passedTestCases\": passed,\n    \"testCasesResult\": test_cases_result\n}))"
  },

  "testCases": [
    {
      "input": "nums = [-1,0,3,5,9,12], target = 9",
      "expectedOutput": "4",
      "isPublic": true
    },
    {
      "input": "nums = [-1,0,3,5,9,12], target = 2",
      "expectedOutput": "-1",
      "isPublic": true
    },
    {
      "input": "nums = [1,3,5,7,9], target = 1",
      "expectedOutput": "0",
      "isPublic": true
    },
    {
      "input": "nums = [1,3,5,7,9], target = 9",
      "expectedOutput": "4",
      "isPublic": true
    },
    {
      "input": "nums = [1,3,5,7,9], target = 6",
      "expectedOutput": "-1",
      "isPublic": true
    }
  ],

  "supportedLanguages": [
    "cpp",
    "java",
    "javascript",
    "python"
  ],

  "expectedTimeComplexity": "O(log n)",
  "expectedSpaceComplexity": "O(1)",

  "companies": [
    "Google",
    "Amazon",
    "Microsoft"
  ],

  "order": 2
}

############################################################
# 3. GET EASY ARRAY PROBLEMS
############################################################

GET {{baseUrl}}/api/problem?topic=ARRAY&difficulty=EASY

############################################################
# 4. UPDATE PROBLEM
############################################################

PUT {{baseUrl}}/api/problem/two-sum
Content-Type: application/json
Cookie: accessToken={{AdminAccessToken}}

{
  "title": "Two Sum Updated",
  "difficulty": "MEDIUM",
  "companies": ["Google", "Amazon", "Microsoft"],
  "order": 2
}

############################################################
# 5. DELETE PROBLEM
############################################################

DELETE {{baseUrl}}/api/problem/two-sum
Cookie: accessToken={{AdminAccessToken}}

###########################################################
# 5. DELETE ALL PROBLEM
############################################################

DELETE {{baseUrl}}/api/problem/all
Cookie: accessToken={{AdminAccessToken}}
